#version 450

layout(local_size_x = 64) in;

// buffer 0 — flat instruction list [op, dest, src1, src2, ...]
// shared by every invocation; each invocation evaluates one instance
layout(set=0, binding=0) readonly buffer Instructions {
    int instr[];
};

// buffer 1 — constant pool followed by metadata:
//   [... pool ..., num_vars, batch_count]
layout(set=0, binding=1) readonly buffer Constants {
    float constants[];
};

// buffer 2 — variable values, row-major: instance i, var j ->
//            variables[i * num_vars + j]
layout(set=0, binding=2) readonly buffer Variables {
    float variables[];
};

// buffer 3 — one result per instance: result[instance]
layout(set=0, binding=3) buffer Result {
    float result[];
};

// register file — 64 registers (per invocation)
float regs[64];

void main() {
    uint gid = gl_GlobalInvocationID.x;

    uint meta       = uint(constants.length());
    int  num_vars   = int(constants[meta - 2]);
    int  batch_size = int(constants[meta - 1]);

    if (gid >= uint(batch_size)) return;

    int n = int(instr.length()) / 4;

    for (int i = 0; i < n; i++) {
        int op   = instr[i*4 + 0];
        int dest = instr[i*4 + 1];
        int src1 = instr[i*4 + 2];
        int src2 = instr[i*4 + 3];

        if      (op == 0) regs[dest] = regs[src1] + regs[src2]; // ADD
        else if (op == 1) regs[dest] = regs[src1] - regs[src2]; // SUB
        else if (op == 2) regs[dest] = regs[src1] * regs[src2]; // MUL
        else if (op == 3) regs[dest] = regs[src1] / regs[src2]; // DIV
        else if (op == 4) regs[dest] = constants[src1];         // LOAD
        else if (op == 5) regs[dest] = variables[uint(gid) * uint(num_vars) + uint(src1)]; // VAR
    }

    int last_dest = instr[(n-1)*4 + 1];
    result[gid] = regs[last_dest];
}
